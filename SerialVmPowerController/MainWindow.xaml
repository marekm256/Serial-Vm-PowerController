<Window x:Class="SerialVmPowerController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial VM Power Controller"
        Height="760"
        Width="1080"
        MinHeight="660"
        MinWidth="940"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Serial VM Power Controller"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />

                <WrapPanel Grid.Row="0"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Border Background="#EEF2F6"
                            BorderBrush="#D8DEE6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Service"
                                       Foreground="#65707D"
                                       Margin="0,0,6,0" />
                            <TextBlock x:Name="ServiceStateText"
                                       Text="Unknown"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="#EEF2F6"
                            BorderBrush="#D8DEE6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Monitor"
                                       Foreground="#65707D"
                                       Margin="0,0,6,0" />
                            <TextBlock x:Name="MonitorStateText"
                                       Text="Stopped"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="#EEF2F6"
                            BorderBrush="#D8DEE6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CTS"
                                       Foreground="#65707D"
                                       Margin="0,0,6,0" />
                            <TextBlock x:Name="CtsStateText"
                                       Text="OFF"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <WrapPanel Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           HorizontalAlignment="Right"
                           Margin="0,14,0,0">
                    <Button x:Name="InstallServiceButton"
                            Content="Install service"
                            MinWidth="112"
                            Click="InstallServiceButton_Click" />
                    <Button x:Name="UninstallServiceButton"
                            Content="Uninstall"
                            MinWidth="92"
                            Click="UninstallServiceButton_Click" />
                    <Button x:Name="StartServiceButton"
                            Content="Start"
                            MinWidth="78"
                            Click="StartServiceButton_Click" />
                    <Button x:Name="StopServiceButton"
                            Content="Stop"
                            MinWidth="78"
                            Click="StopServiceButton_Click" />
                    <Button x:Name="RefreshServiceButton"
                            Content="Refresh"
                            MinWidth="86"
                            Click="RefreshServiceButton_Click"
                            Margin="0" />
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <GroupBox Header="Serial port">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="COM port"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="ComPortComboBox"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          IsEditable="True"
                                          Margin="0,0,8,10" />
                                <Button x:Name="RefreshPortsButton"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Content="Refresh"
                                        Click="RefreshPortsButton_Click"
                                        Margin="0,0,0,10" />

                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal">
                                    <CheckBox x:Name="DtrCheckBox"
                                              Content="Enable DTR"
                                              Margin="0,0,24,0" />
                                    <CheckBox x:Name="RtsCheckBox"
                                              Content="Enable RTS" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Timing">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="CTS debounce (s)"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="DebounceSecondsBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Soft timeout (s)"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="SoftTimeoutSecondsBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Hard timeout (s)"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="HardTimeoutSecondsBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Host shutdown delay (s)"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="HostShutdownDelaySecondsBox"
                                         Grid.Row="3"
                                         Grid.Column="1" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <GroupBox Header="VMware">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Install check"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="VmwareInstallStatusText"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Foreground="#4B5563" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="VMX file"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="VmxPathBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,0,8,0"
                                         HorizontalScrollBarVisibility="Auto" />
                                <Button x:Name="BrowseVmxButton"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Content="Browse"
                                        Click="BrowseVmxButton_Click"
                                        Margin="0" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Modes">
                            <StackPanel>
                                <CheckBox x:Name="ServiceAutoStartCheckBox"
                                          Content="Install service with automatic startup"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="StartVmOnServiceStartCheckBox"
                                          Content="Start VM in KVM mode when service starts"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="BlockCtsShutdownCheckBox"
                                          Content="Block CTS shutdown"
                                          Margin="0,0,0,8" />
                                <TextBlock Text="Testing only. Turn this OFF for normal operation so CTS can shut down the VM and host."
                                           TextWrapping="Wrap"
                                           Foreground="#8A4B00"
                                           FontSize="12"
                                           Margin="22,-4,0,10" />
                                <CheckBox x:Name="ShutdownHostCheckBox"
                                          Content="Shutdown host after VM stop" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>

                <GroupBox Header="Actions" Margin="0,0,0,12">
                    <WrapPanel>
                        <Button x:Name="SaveButton"
                                Content="Save settings"
                                MinWidth="118"
                                Margin="0,0,8,0"
                                Click="SaveButton_Click" />
                        <Button x:Name="SoftStopButton"
                                Content="Soft stop VM"
                                MinWidth="118"
                                Margin="0,0,8,0"
                                Click="SoftStopButton_Click" />
                        <Button x:Name="HardStopButton"
                                Content="Hard stop VM"
                                MinWidth="118"
                                Margin="0,0,8,0"
                                Click="HardStopButton_Click" />
                        <Button x:Name="ShutdownHostButton"
                                Content="Shutdown host"
                                MinWidth="118"
                                Margin="0"
                                Click="ShutdownHostButton_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Log" Margin="0">
                    <TextBox x:Name="LogTextBox"
                             Height="230"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#111820"
                             Foreground="#E8EDF2"
                             BorderThickness="0" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


